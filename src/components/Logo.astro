---
// Logo tạm bằng chữ. Khi có file logo thật: đặt vào public/assets/logo.png
// rồi thay khối .logo__mark bằng <img src={url('/assets/logo.png')} alt="..." width="48" height="48" />
import { site } from '../data/site';
import { url } from '../utils/url';
---

<a href={url('/')} class="logo" aria-label={`${site.company} – Trang chủ`}>
  <span class="logo__mark">{site.shortName}</span>
  <span class="logo__text">
    <span class="logo__company">{site.company.toUpperCase()}</span>
    <span class="logo__slogan">{site.slogan}</span>
  </span>
</a>
