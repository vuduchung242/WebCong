---
// Header dùng chung. `active`: tên file trang hiện tại (VD 'nenkin.html') để tô menu.
interface Props { active?: string; isHome?: boolean }
const { active = '', isHome = false } = Astro.props;
const contactHref = isHome ? '#contact' : 'index.html#contact';
---

<header class="header" id="header">
  <div class="container header__inner">
    <a href="index.html" class="logo">
      <img src="assets/logos/czt-logo-2026.png" alt="CZT - CZT International Service" class="logo__img">
      <span class="logo__text">
        <strong>CÔNG TY TNHH DỊCH VỤ QUỐC TẾ CZT</strong>
        <small>Tận tâm trong từng bước – Tin cậy trong từng dịch vụ.</small>
        <em class="logo__brand">Cô Záo Trang</em>
      </span>
    </a>

    <nav class="nav" id="nav">
      <ul>
        <li><a href="index.html" class={active === 'index.html' ? 'is-active' : undefined}>Trang chủ</a></li>
        <li><a href="nenkin.html" class={active === 'nenkin.html' ? 'is-active' : undefined}>Nenkin</a></li>
        <li><a href="visa.html" class={active === 'visa.html' ? 'is-active' : undefined}>Visa</a></li>
        <li><a href="thue.html" class={active === 'thue.html' ? 'is-active' : undefined}>Thuế</a></li>
        <li><a href="dich-vu-khac.html" class={active === 'dich-vu-khac.html' ? 'is-active' : undefined}>Dịch vụ khác</a></li>
        <li><a href="ve-czt.html" class={active === 've-czt.html' ? 'is-active' : undefined}>Về CZT</a></li>
        <li><a href="faq.html" class={active === 'faq.html' ? 'is-active' : undefined}>FAQ</a></li>
      </ul>
    </nav>

    <div class="header__cta">
      <a href={contactHref} class="btn btn--primary">Tư vấn miễn phí</a>
      <button class="nav-toggle" id="navToggle" aria-label="Mở menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
