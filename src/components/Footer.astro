        <a href="https://zalo.me/g/d9w8djm0zfuvlax0gopg" target="_blank" rel="noopener" title="Zalo"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2.9c-5.16 0-9.35 3.53-9.35 7.89 0 2.48 1.36 4.69 3.48 6.13-.13 1.03-.6 2.2-1.35 3.05-.27.3-.3.79.37.72 2.02-.36 3.63-1.2 4.7-1.9.68.12 1.39.19 2.15.19 5.16 0 9.35-3.53 9.35-7.89S17.16 2.9 12 2.9zM8.75 7.35h6.5v1.75l-4.05 4.8h4.05v1.75h-6.7v-1.75l4.05-4.8h-3.85z"/></svg></a>
