---
import Logo from './Logo.astro';
import { site, footerCols } from '../data/site';
import { url } from '../utils/url';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo />
        <p class="footer__about">
          Đồng hành cùng người Việt trong các thủ tục Nhật Bản: Nenkin, thuế, visa và dịch thuật. Hỗ trợ hằng ngày {site.supportHours}.
        </p>
      </div>
      {
        footerCols.map((col) => (
          <div>
            <h4 class="footer__title">{col.title}</h4>
            <ul class="footer__links">
              {col.links.map((l) => (
                <li>
                  <a href={url(l.href)}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer__bottom">
      <span>© <span id="year">{new Date().getFullYear()}</span> {site.company}. MST: {site.taxCode}</span>
      <span>{site.email}</span>
    </div>
  </div>
</footer>

<script>
  const y = document.getElementById('year');
  if (y) y.textContent = String(new Date().getFullYear());
</script>
