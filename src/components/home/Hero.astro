---
import Icon from '../Icon.astro';
import { stats, services } from '../../data/home';
import { site } from '../../data/site';
import { url } from '../../utils/url';
---

<section class="hero" id="home">
  <!-- Hình minh họa núi Phú Sĩ + mặt trời (vẽ bằng SVG). Có ảnh banner thật thì thay khối này bằng <img>. -->
  <svg class="hero__art" viewBox="0 0 760 460" aria-hidden="true">
    <defs>
      <linearGradient id="fuji" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
        <stop offset="0.28" stop-color="#dbe6ff" stop-opacity="0.9" />
        <stop offset="0.3" stop-color="#3f6fd8" stop-opacity="0.75" />
        <stop offset="1" stop-color="#143a97" stop-opacity="0.2" />
      </linearGradient>
      <radialGradient id="sun" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#f6c75a" />
        <stop offset="1" stop-color="#e0a92e" stop-opacity="0.85" />
      </radialGradient>
    </defs>
    <circle cx="560" cy="150" r="92" fill="url(#sun)" opacity="0.9" />
    <path d="M60 460 L330 150 Q380 118 430 150 L720 460 Z" fill="url(#fuji)" />
    <path d="M330 150 Q380 118 430 150 L455 178 L425 168 L405 190 L380 166 L352 188 L332 168 L305 180 Z" fill="#fff" />
    <path d="M0 460 Q180 360 360 420 T760 400 V460 Z" fill="#0d1733" opacity="0.55" />
    <g fill="#ffd1dc" opacity="0.9">
      <circle cx="120" cy="120" r="6" /><circle cx="160" cy="180" r="4" /><circle cx="680" cy="300" r="5" />
      <circle cx="240" cy="80" r="3.5" /><circle cx="700" cy="90" r="4" /><circle cx="90" cy="260" r="3" />
    </g>
  </svg>

  <div class="container">
    <div class="hero__inner">
      <span class="hero__eyebrow">{site.shortName} – {site.name}</span>
      <h1>Đồng hành cùng bạn trên hành trình thủ tục <em>Nhật Bản</em></h1>
      <p class="hero__services">Nenkin · Thuế Nhật Bản · Visa Gino 2</p>
      <p class="hero__desc">
        Từ {site.name} đến {site.company} – tận tâm hỗ trợ, minh bạch chi phí và đồng hành theo dõi hồ sơ đến khi hoàn tất.
      </p>

      <div class="hero__stats">
        {
          stats.map((s) => (
            <div class="hero__stat">
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>

      <div class="hero__actions">
        <a href="#contact" class="btn btn--gold">Tư vấn miễn phí <Icon name="arrow-right" /></a>
        <a href={url('/ve-czt.html')} class="btn btn--ghost">Tìm hiểu về {site.name} <Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>

<div class="container">
  <div class="hero-cards">
    {
      services.map((s) => (
        <a href={url(s.href)} class:list={['hero-card', `accent-${s.key}`]}>
          <span class="hero-card__icon">
            <Icon name={s.icon} size={26} />
          </span>
          <span class="hero-card__tag">{s.tag}</span>
          <span class="hero-card__sub">{s.short}</span>
          <span class="hero-card__link">
            Xem chi tiết <Icon name="arrow-right" />
          </span>
        </a>
      ))
    }
  </div>
</div>
