---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { collabs } from '../../data/home';
---

<section class="sec sec--gray" id="collab">
  <div class="container">
    <SectionHead tag="Cộng tác cùng CZT" title="Cơ hội cộng tác cùng" highlight="CZT" sub="Thời gian linh hoạt — Thu nhập theo kết quả" />

    <div class="collab-grid">
      {
        collabs.map((c) => (
          <article class="collab reveal">
            <div class="collab__top">
              <span class="collab__ic">
                <Icon name={c.icon} size={28} />
              </span>
              <div>
                <h3>{c.title}</h3>
                <span class="collab__tag">{c.tag}</span>
              </div>
            </div>
            <p>{c.desc}</p>
            <ul class="checks">
              {c.points.map((p) => (
                <li>
                  <Icon name="check-circle" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
            <a href="#contact" class="btn btn--outline" data-service="Cộng tác viên">
              Đăng ký cộng tác <Icon name="arrow-right" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
