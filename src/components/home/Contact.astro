---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { site } from '../../data/site';

const serviceOptions = ['Nenkin', 'Visa Tokutei Gino 2', 'Hoàn / Giảm thuế', 'Dịch thuật & Phiên dịch', 'Dịch vụ khác', 'Cộng tác viên'];
---

<section class="contact" id="contact">
  <div class="container contact__grid">
    <div class="contact__info">
      <SectionHead
        tag="Liên hệ tư vấn"
        title="Tư vấn miễn phí cùng"
        highlight="CZT"
        sub="Nhắn tin cho CZT qua các kênh bên dưới hoặc để lại thông tin để được kiểm tra nhu cầu và tư vấn cụ thể."
      />

      <ul class="checks">
        <li><Icon name="check-circle" /><span>Tư vấn miễn phí, không ràng buộc.</span></li>
        <li><Icon name="check-circle" /><span>Thông tin và chi phí được trao đổi rõ ràng.</span></li>
        <li><Icon name="check-circle" /><span>Bảo mật thông tin khách hàng.</span></li>
      </ul>

      <div class="contact__socials">
        <a class="social-btn social-btn--msg" href={site.social.messenger} target="_blank" rel="noopener"><Icon name="messenger" /> Messenger</a>
        <a class="social-btn social-btn--zalo" href={site.social.zalo} target="_blank" rel="noopener"><Icon name="zalo" /> Zalo</a>
        <a class="social-btn social-btn--fb" href={site.social.facebook} target="_blank" rel="noopener"><Icon name="facebook" /> Facebook</a>
        <a class="social-btn social-btn--tiktok" href={site.social.tiktok} target="_blank" rel="noopener"><Icon name="tiktok" /> TikTok</a>
      </div>

      <ul class="info-list">
        <li><Icon name="clock" /><span>Tiếp nhận tư vấn hằng ngày từ {site.supportHours}.</span></li>
        <li><Icon name="phone" /><a href={`tel:${site.hotline.replace(/[^\d+]/g, '')}`}>Hotline: {site.hotline}</a></li>
        <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><Icon name="map-pin" /><a href={site.mapUrl} target="_blank" rel="noopener">{site.address}</a></li>
      </ul>

      <div class="company-card">
        <strong>{site.company}</strong>
        <span>MST: {site.taxCode}</span>
        <span>Địa chỉ: {site.address}</span>
      </div>
    </div>

    <div class="form-card reveal">
      <h3>Đăng ký tư vấn</h3>
      <p>Để lại thông tin, CZT sẽ liên hệ lại trong vòng 24 giờ.</p>

      <form id="bookingForm" data-endpoint={site.formEndpoint} novalidate>
        <div class="field">
          <label for="fullname">Họ và tên <span>*</span></label>
          <input id="fullname" name="fullname" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="phone">Số điện thoại / Zalo <span>*</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <div class="field">
          <label for="service">Dịch vụ quan tâm</label>
          <select id="service" name="service">
            {serviceOptions.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="message">Nội dung cần tư vấn</label>
          <textarea id="message" name="message" rows="4" placeholder="VD: Mình đã về Việt Nam, đóng Nenkin 3 năm..."></textarea>
        </div>
        <!-- Bẫy chống spam: người thật không thấy ô này -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />

        <button type="submit" class="btn btn--primary btn--block">
          Gửi thông tin <Icon name="send" />
        </button>
        <p class="form-note" id="formNote" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('bookingForm') as HTMLFormElement | null;
  const note = document.getElementById('formNote')!;
  const select = document.getElementById('service') as HTMLSelectElement | null;

  // Nút có data-service (VD "Đăng ký cộng tác") tự chọn sẵn dịch vụ trong form
  document.querySelectorAll<HTMLElement>('[data-service]').forEach((el) =>
    el.addEventListener('click', () => {
      if (select) select.value = el.dataset.service!;
    }),
  );

  const show = (msg: string, ok: boolean) => {
    note.textContent = msg;
    note.className = `form-note ${ok ? 'is-success' : 'is-error'}`;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const fullname = String(data.get('fullname') || '').trim();
    const phone = String(data.get('phone') || '').trim();

    if (data.get('website')) return; // bot điền vào ô bẫy
    if (!fullname || !phone) return show('Vui lòng nhập đầy đủ Họ tên và Số điện thoại.', false);
    if (!/^[0-9+()\s-]{8,15}$/.test(phone)) return show('Số điện thoại không hợp lệ, vui lòng kiểm tra lại.', false);

    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      // Chưa cấu hình formEndpoint trong src/data/site.ts
      console.warn('[form] Chưa có formEndpoint, dữ liệu chưa được gửi đi:', Object.fromEntries(data));
      show('Cảm ơn bạn! (Bản demo: chưa nối Google Sheet nên dữ liệu chưa được gửi đi.)', true);
      form.reset();
      return;
    }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    note.className = 'form-note';
    note.textContent = 'Đang gửi...';
    try {
      // Google Apps Script không trả header CORS, nên gửi kiểu no-cors (không đọc được phản hồi).
      await fetch(endpoint, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(data as any) });
      show('Cảm ơn bạn! CZT đã nhận thông tin và sẽ liên hệ trong vòng 24h.', true);
      form.reset();
    } catch {
      show('Gửi không thành công. Vui lòng thử lại hoặc nhắn CZT qua Zalo/Messenger.', false);
    } finally {
      btn.disabled = false;
    }
  });
</script>
