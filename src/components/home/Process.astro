---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { steps } from '../../data/home';
---

<section class="sec sec--gray" id="process">
  <div class="container">
    <SectionHead tag="Quy trình" title="Quy trình làm việc tại" highlight="CZT" sub="Đơn giản – Rõ ràng – Theo sát từng bước." />

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step reveal">
            <span class="step__num">{i + 1}</span>
            <Icon name={s.icon} size={34} class="step__ic" strokeWidth={1.8} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
